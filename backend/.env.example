# Public HTTPS base URL of this backend. SabPaisa must be able to reach it.
BACKEND_URL=https://api.mirchiapp.in

# Optional explicit overrides. When omitted, BACKEND_URL is used.
SABPAISA_RETURN_URL=https://api.mirchiapp.in/api/payment/return
SABPAISA_WEBHOOK_URL=https://api.mirchiapp.in/api/payment/webhook

# Apple Sign-In Client/Bundle IDs (comma-separated for multiple: iOS Bundle ID, Web Service ID)
# e.g., com.mirchiott1.app
APPLE_CLIENT_ID=com.mirchiott1.app

